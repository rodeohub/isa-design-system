{
  "$description": "Spacing on a 4px grid, radii, sizes and breakpoints. Breakpoints taken from SportHub.",
  "space": {
    "$type": "dimension",
    "0": { "$value": "0" }, "1": { "$value": "0.25rem" }, "2": { "$value": "0.5rem" }, "3": { "$value": "0.75rem" },
    "4": { "$value": "1rem" }, "5": { "$value": "1.25rem" }, "6": { "$value": "1.5rem" }, "8": { "$value": "2rem" },
    "10": { "$value": "2.5rem" }, "12": { "$value": "3rem" }, "16": { "$value": "4rem" }, "24": { "$value": "6rem" }
  },
  "radius": {
    "$type": "dimension",
    "none": { "$value": "0" }, "sm": { "$value": "0.25rem" }, "md": { "$value": "0.5rem" },
    "lg": { "$value": "0.75rem" }, "xl": { "$value": "1rem" }, "full": { "$value": "9999px" }
  },
  "size": {
    "$type": "dimension",
    "touch-target": { "$value": "2.75rem", "$description": "44px minimum for anything tappable (WCAG 2.5.5 / Apple HIG)." },
    "control-sm": { "$value": "2.25rem", "$description": "Visual height of small controls (36px). The tappable area is still extended to touch-target." },
    "focus-ring-width": { "$value": "2px" },
    "focus-ring-offset": { "$value": "2px" },
    "content-max": { "$value": "80rem" },
    "spinner-sm": { "$value": "1rem" },
    "spinner-md": { "$value": "1.5rem" },
    "spinner-lg": { "$value": "2.5rem" },
    "tooltip-max": { "$value": "16rem" },
    "card-min": { "$value": "17.5rem", "$description": "Narrowest card in a card grid (280px)." },
    "dialog-max": { "$value": "37rem", "$description": "Maximum dialog width (592px)." }
  },
  "breakpoint": {
    "$type": "dimension",
    "xs": { "$value": "20rem" }, "sm": { "$value": "40rem" }, "md": { "$value": "48rem" },
    "lg": { "$value": "64rem" }, "xl": { "$value": "80rem" }
  },
  "shadow": {
    "$type": "shadow",
    "$description": "Elevation. Simplified to CSS strings (gray 900 at low opacity).",
    "md": { "$value": "0 2px 8px #1515151f" },
    "lg": { "$value": "0 12px 32px #15151533" }
  },
  "z": {
    "$type": "number",
    "$description": "Stacking order. Dialogs use the browser's top layer and need no z-index.",
    "sticky": { "$value": 10 },
    "tooltip": { "$value": 40 }
  },
  "duration": {
    "$type": "duration",
    "fast": { "$value": "120ms" }, "normal": { "$value": "200ms" }, "slow": { "$value": "320ms" }
  }
}
