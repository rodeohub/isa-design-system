{
  "$description": "Semantic color roles for the light theme (the only theme for now). A dark theme is added later as themes/dark.json with the same keys and different values. Projects and components use ONLY these roles.",
  "color": {
    "$type": "color",
    "text": {
      "default": { "$value": "{color.gray.700}", "$description": "Body and headings." },
      "muted": { "$value": "{color.gray.500}", "$description": "Secondary text, help text, captions. Still AA on surface.default and surface.subtle." },
      "inverse": { "$value": "{color.white}", "$description": "Text on dark or brand surfaces." },
      "link": { "$value": "{color.green.700}", "$description": "Green 700, not 600: links also sit on surface.subtle where 600 falls below 4.5:1. Underline links in body text." },
      "link-hover": { "$value": "{color.green.800}" },
      "danger": { "$value": "{color.red.700}", "$description": "Error messages." },
      "success": { "$value": "{color.green.700}" }
    },
    "surface": {
      "default": { "$value": "{color.white}" },
      "subtle": { "$value": "{color.gray.50}" },
      "muted": { "$value": "{color.gray.100}" },
      "inverse": { "$value": "{color.gray.800}" },
      "brand": { "$value": "{color.green.700}", "$description": "Header bars and brand areas with text.inverse on top." },
      "danger": { "$value": "{color.red.50}" },
      "success": { "$value": "{color.green.50}" }
    },
    "border": {
      "default": { "$value": "{color.gray.200}", "$description": "Dividers and card outlines (decorative)." },
      "strong": { "$value": "{color.gray.400}", "$description": "Input borders and other borders that must be seen (3:1)." },
      "focus": { "$value": "{color.green.700}", "$description": "Focus ring on light surfaces." },
      "focus-inverse": { "$value": "{color.white}", "$description": "Focus ring on surface.brand, surface.inverse, primary and danger buttons." },
      "danger": { "$value": "{color.red.600}" }
    },
    "action": {
      "primary-bg": { "$value": "{color.green.600}" },
      "primary-bg-hover": { "$value": "{color.green.700}" },
      "primary-bg-active": { "$value": "{color.green.800}" },
      "primary-fg": { "$value": "{color.white}" },
      "secondary-bg": { "$value": "{color.white}" },
      "secondary-bg-hover": { "$value": "{color.green.50}" },
      "secondary-bg-active": { "$value": "{color.green.100}" },
      "secondary-fg": { "$value": "{color.green.700}" },
      "secondary-border": { "$value": "{color.green.600}" },
      "danger-bg": { "$value": "{color.red.600}" },
      "danger-bg-hover": { "$value": "{color.red.700}" },
      "danger-bg-active": { "$value": "{color.red.800}" },
      "danger-secondary-bg": { "$value": "{color.white}" },
      "danger-secondary-bg-hover": { "$value": "{color.red.50}" },
      "danger-secondary-bg-active": { "$value": "{color.red.100}" },
      "danger-secondary-fg": { "$value": "{color.red.700}" },
      "danger-secondary-border": { "$value": "{color.red.600}" },
      "neutral-bg": { "$value": "{color.white}", "$description": "Neutral (default) button: an action with no emphasis." },
      "neutral-bg-hover": { "$value": "{color.gray.50}" },
      "neutral-bg-active": { "$value": "{color.gray.100}" },
      "neutral-fg": { "$value": "{color.gray.700}" },
      "neutral-border": { "$value": "{color.gray.400}" },
      "ghost-fg": { "$value": "{color.gray.700}", "$description": "Ghost button: no background until hovered. Light surfaces only." },
      "ghost-bg-hover": { "$value": "{color.gray.100}" },
      "ghost-bg-active": { "$value": "{color.gray.200}" },
      "danger-fg": { "$value": "{color.white}" },
      "disabled-bg": { "$value": "{color.gray.100}" },
      "disabled-fg": { "$value": "{color.gray.400}", "$description": "Disabled controls are exempt from contrast rules, but keep them recognisable." }
    },
    "table": {
      "header-bg": { "$value": "{color.gray.50}" },
      "header-fg": { "$value": "{color.gray.500}" },
      "row-hover-bg": { "$value": "{color.gray.50}" },
      "border": { "$value": "{color.gray.200}" }
    },
    "tooltip": {
      "bg": { "$value": "{color.gray.800}" },
      "fg": { "$value": "{color.white}" }
    },
    "spinner": {
      "fg": { "$value": "{color.green.500}", "$description": "Brand green: a graphic, needs 3:1." },
      "track": { "$value": "{color.gray.200}" }
    },
    "selected": {
      "$description": "The chosen item in a set: the current tab, a selected filter or row.",
      "fg": { "$value": "{color.green.700}" },
      "bg": { "$value": "{color.green.50}" },
      "border": { "$value": "{color.green.700}" }
    },
    "overlay": {
      "backdrop": { "$value": "#15151599", "$description": "Dimmed layer behind a dialog (gray 900 at 60%)." }
    },
    "field": {
      "$description": "Form controls: text inputs, text areas, selects, checkboxes, radios.",
      "bg": { "$value": "{color.white}" },
      "bg-readonly": { "$value": "{color.gray.50}" },
      "bg-disabled": { "$value": "{color.gray.100}" },
      "fg": { "$value": "{color.gray.700}" },
      "fg-disabled": { "$value": "{color.gray.400}", "$description": "Disabled controls are exempt from contrast rules." },
      "placeholder": { "$value": "{color.gray.500}", "$description": "Placeholders are hints, never the label." },
      "border": { "$value": "{color.gray.400}" },
      "border-hover": { "$value": "{color.gray.500}" },
      "border-invalid": { "$value": "{color.red.600}" },
      "accent": { "$value": "{color.green.600}", "$description": "Checked checkboxes and radios." }
    },
    "brand": {
      "red": { "$value": "{color.red.500}", "$description": "Logos, large display text (24px+), decoration. Not for small text on white." },
      "green": { "$value": "{color.green.500}", "$description": "Logos, large display text (24px+), decoration. Not for small text on white." },
      "gray": { "$value": "{color.gray.500}" }
    },
    "status": {
      "success-fg": { "$value": "{color.green.800}" }, "success-bg": { "$value": "{color.green.100}" },
      "danger-fg": { "$value": "{color.red.700}" }, "danger-bg": { "$value": "{color.red.100}" },
      "warning-fg": { "$value": "{color.category-hue.orange.dark}" }, "warning-bg": { "$value": "{color.category-hue.orange.light}" },
      "info-fg": { "$value": "{color.category-hue.blue.dark}" }, "info-bg": { "$value": "{color.category-hue.blue.light}" }
    },
    "category": {
      "$description": "Category colors for badges and tags (disciplines, contest levels, roles). Separate from brand and status colors. Each has fg and bg; use them as a pair.",
      "neutral-fg": { "$value": "{color.gray.700}" }, "neutral-bg": { "$value": "{color.gray.100}" },
      "green-fg": { "$value": "{color.category-hue.green.dark}" }, "green-bg": { "$value": "{color.category-hue.green.light}" },
      "red-fg": { "$value": "{color.category-hue.red.dark}" }, "red-bg": { "$value": "{color.category-hue.red.light}" },
      "brand-fg": { "$value": "{color.green.800}" }, "brand-bg": { "$value": "{color.green.100}" },
      "blue-fg": { "$value": "{color.category-hue.blue.dark}" }, "blue-bg": { "$value": "{color.category-hue.blue.light}" },
      "teal-fg": { "$value": "{color.category-hue.teal.dark}" }, "teal-bg": { "$value": "{color.category-hue.teal.light}" },
      "orange-fg": { "$value": "{color.category-hue.orange.dark}" }, "orange-bg": { "$value": "{color.category-hue.orange.light}" },
      "yellow-fg": { "$value": "{color.category-hue.yellow.dark}" }, "yellow-bg": { "$value": "{color.category-hue.yellow.light}" },
      "pink-fg": { "$value": "{color.category-hue.pink.dark}" }, "pink-bg": { "$value": "{color.category-hue.pink.light}" },
      "violet-fg": { "$value": "{color.category-hue.violet.dark}" }, "violet-bg": { "$value": "{color.category-hue.violet.light}" },
      "purple-fg": { "$value": "{color.category-hue.purple.dark}" }, "purple-bg": { "$value": "{color.category-hue.purple.light}" }
    }
  }
}
